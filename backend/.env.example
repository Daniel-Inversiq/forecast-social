# Required in production (ENV=production)
ENV=development
JWT_SECRET=generate-a-random-32-char-minimum-secret
# Access token lifetime (minutes). Default 120 (2h). Shorter in prod reduces JWT exposure window.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database (default: SQLite file in backend working directory)
# DATABASE_URL=sqlite:///./forecast_social.db

# If import hangs on Windows/Python 3.13, keep this set (also defaulted in app/_import_bootstrap.py)
# DISABLE_SQLALCHEMY_CEXT_RUNTIME=1

# Optional: synthetic feed events (never runs when ENV=production)
ENABLE_EVENT_SCHEDULER=

# Phase 3A - USDC treasury settlement
BASE_RPC_URL=
POLYGON_RPC_URL=
USDC_BASE_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_POLYGON_CONTRACT=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
TREASURY_WALLET_ADDRESS=
MIN_DEPOSIT_USDC=5
MAX_USER_EXPOSURE_USDC=100
MAX_MARKET_EXPOSURE_USDC=25

# Stripe — Intelligence Access subscription
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_INTELLIGENCE_PRICE_ID=price_...
FRONTEND_URL=http://localhost:3000

# Comma-separated extra CORS origins (preview deploys, staging)
# CORS_EXTRA_ORIGINS=https://staging.example.com

# Wallet identity (Privy) — create at https://dashboard.privy.io
# NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Sentry (error monitoring) — off in ENV=development unless SENTRY_ENABLED=true
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENABLED=true
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_DEBUG_ROUTES=true

# Destructive seed (python -m app.forecasting.seed) — blocked in production unless set
# ALLOW_SEED=1

# World Event source configuration
# Optional per-category RSS overrides (comma-separated URLs).
# If unset for a category in development, built-in defaults are used.
# EVENT_SOURCES_MACRO=https://feeds.reuters.com/reuters/businessNews,https://finance.yahoo.com/news/rssindex
# EVENT_SOURCES_GEOPOLITICS=https://feeds.reuters.com/Reuters/worldNews
# EVENT_SOURCES_POLITICS=https://www.politico.com/rss/politics08.xml,https://api.axios.com/feed/politics
# EVENT_SOURCES_CRYPTO=https://www.coindesk.com/arc/outboundfeeds/rss/
# EVENT_SOURCES_AI=https://venturebeat.com/category/ai/feed/
# EVENT_SOURCES_SPORTS=https://sports.yahoo.com/rss/
# EVENT_SOURCES_CLIMATE=https://www.climatechangenews.com/feed/
#
# Optional custom feeds:
# Format: Name|category|url,Name|category|url
# EVENT_SOURCES_CUSTOM=IMF Blog|macro|https://www.imf.org/en/News/RSS,UN Climate|climate|https://news.un.org/feed/subscribe/en/news/topic/climate-change/feed/rss.xml

# Agent LLM generation (backend only — keys never sent to frontend)
# SCRY_LLM_PROVIDER=openai
# SCRY_LLM_MODEL=gpt-4o-mini
# SCRY_LLM_TEMPERATURE=0.7
# SCRY_LLM_TOP_P=1.0
# SCRY_LLM_MAX_TOKENS=256
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
