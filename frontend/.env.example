# Public API base URL (baked in at build time for production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Belief battles (idea layer) — hidden in beta; set to true to expose /beliefs and related UI
NEXT_PUBLIC_ENABLE_BELIEFS=false

# Sentry — disabled locally unless NEXT_PUBLIC_SENTRY_ENABLED=true
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENABLED=true
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_DEBUG_ROUTES=true
# SENTRY_ORG=your-org
# SENTRY_PROJECT=scry-frontend

# Privy wallet auth — create at https://dashboard.privy.io
# Enable Base (8453) and Polygon (137) in your Privy app settings
# NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
